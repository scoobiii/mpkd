{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mpkd-cad/v1",
  "title": "MPKD CAD Interoperability Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","project_id","project_version","units","layers","blocks","curves","warnings"],
  "properties": {
    "schema": {"const":"mpkd-cad/v1"},
    "project_id": {"type":"string","minLength":1},
    "project_version": {"type":"integer","minimum":1},
    "units": {"enum":["mm","cm","m"]},
    "layers": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "blocks": {"type":"array","items":{"$ref":"#/$defs/block"}},
    "curves": {"type":"array","items":{"$ref":"#/$defs/curve"}},
    "warnings": {"type":"array","items":{"type":"string"}}
  },
  "$defs": {
    "block": {
      "type":"object","additionalProperties":false,
      "required":["instance_id","catalog_id","layer","origin_mm","rotation_z_deg","parameters","metadata"],
      "properties": {
        "instance_id":{"type":"string","minLength":1},
        "catalog_id":{"type":"string","minLength":1},
        "layer":{"type":"string","minLength":1},
        "origin_mm":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"items":false},
        "rotation_z_deg":{"type":"number"},
        "parameters":{"type":"object","additionalProperties":{"type":["number","string","boolean"]}},
        "metadata":{"type":"object","additionalProperties":{"type":["number","string","boolean","null"]}}
      }
    },
    "curve": {
      "type":"object","additionalProperties":false,
      "required":["curve_id","utility","points_mm","diameter_mm","metadata"],
      "properties": {
        "curve_id":{"type":"string","minLength":1},
        "utility":{"type":"string","minLength":1},
        "points_mm":{"type":"array","minItems":2,"items":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"items":false}},
        "diameter_mm":{"type":["number","null"],"exclusiveMinimum":0},
        "metadata":{"type":"object","additionalProperties":{"type":["number","string","boolean","null"]}}
      }
    }
  }
}
